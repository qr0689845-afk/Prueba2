        i = 0
        for j in Inventario:
            if (Inventario[i][0] == nombre):
                del(Inventario[i])
            i += 1

    def Mostrar(self):
        print(Inventario)

    def ActualizarITEM(self,nombre,nuevonomb,nuevotipo,nuevocant):
        i = 0
        for j in Inventario:
            if (Inventario[i][0] == nombre):
                Inventario[i]=[nuevonomb,nuevotipo,nuevocant]
            i += 1

